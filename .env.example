NODE_ENV=development
PORT=3007

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/wanderlanka-community

# JWT Configuration (should match user-service)
JWT_SECRET=your-jwt-secret-change-in-production

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# CORS Origins
CORS_ORIGIN_WEB=http://localhost:5173
CORS_ORIGIN_MOBILE=http://172.20.10.2:8081

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Shared only by trusted backend services; never expose to web/mobile clients.
INTERNAL_SERVICE_TOKEN=
